Output docs/assets/images/hydrozoa-demo.gif
Set Shell "bash"
Set FontSize 18
Set Width 1000
Set Height 560
Set Padding 24
Set TypingSpeed 35ms
Set Theme {"background":"#071019","foreground":"#dce7ef","cursor":"#2dd4bf","black":"#071019","brightBlack":"#5f7484","cyan":"#2dd4bf","brightCyan":"#67e8f9","magenta":"#c084fc","brightMagenta":"#e879f9"}

Type "hydrozoa sync --matrix production"
Enter
Sleep 800ms
Type "discovering source namespaces..."
Enter
Sleep 500ms
Type "github/acme/platform       ready"
Enter
Type "gitlab/backup/platform     connected"
Enter
Sleep 700ms
Type "mirror complete            2.41s"
Enter
Sleep 2s
