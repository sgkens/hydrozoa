# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string.
DATABASE_URL="postgresql://hydrozoa:replace-me@localhost:5432/hydrozoa"

# Production requires unique values of at least 32 characters.
JWT_SECRET="replace-with-a-random-value-of-at-least-32-characters"
HYDROZOA_MASTER_KEY="replace-with-a-random-value-of-at-least-32-characters"

# Required only when creating the initial administrator (12+ characters).
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-initial-password"
